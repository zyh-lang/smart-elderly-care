<view class="page">
  <view class="card order-card" wx:for="{{workOrders}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
    <view class="row">
      <text class="label">工单号</text>
      <text class="value">{{item.workOrderNo}}</text>
    </view>
    <view class="row">
      <text class="label">服务商</text>
      <text class="value">{{item.providerName || '-'}}</text>
    </view>
    <view class="row">
      <text class="label">状态</text>
      <text class="status status-{{item.status}}">{{statusText[item.status] || item.status}}</text>
    </view>
  </view>
  <view class="empty" wx:if="{{!workOrders.length}}">暂无工单，去首页下单吧</view>
</view>
