.order-card .row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
}

.label { color: #909399; }

.value { color: #333; max-width: 400rpx; word-break: break-all; text-align: right; }

.status { font-weight: 600; }

.status-DISPATCHED { color: #fa8c16; }
.status-IN_SERVICE { color: #1677ff; }
.status-WAIT_ACCEPT { color: #fa8c16; }
.status-COMPLETED { color: #52c41a; }
.status-EVALUATED { color: #52c41a; }
.status-CANCELLED { color: #999; }
.status-COMPLAINED { color: #ff4d4f; }
