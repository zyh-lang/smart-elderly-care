.elder-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-weight: 600;
}

.picker-value { color: #1677ff; }

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.grid { display: flex; flex-wrap: wrap; }

.grid-item {
  width: 50%;
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  box-sizing: border-box;
  padding-right: 20rpx;
}

.k { color: #909399; width: 140rpx; }

.v { flex: 1; }

.no-record { color: #bbb; font-size: 26rpx; }

.add-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.type-picker {
  width: 180rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
}

.value-input {
  flex: 1;
  height: 64rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
}

.metric-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.metric-type {
  width: 140rpx;
  color: #1677ff;
  font-weight: 600;
}

.metric-value { flex: 1; font-weight: 600; }

.metric-time { color: #bbb; font-size: 24rpx; }

.med-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.med-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.med-name { font-weight: 600; }

.med-dosage { color: #1677ff; }

.med-sub { color: #909399; font-size: 24rpx; margin-top: 6rpx; }
