.status-banner {
  text-align: center;
  font-size: 40rpx;
  font-weight: bold;
  padding: 20rpx 0 30rpx;
}

.status-DISPATCHED { color: #fa8c16; }
.status-IN_SERVICE { color: #1677ff; }
.status-WAIT_ACCEPT { color: #fa8c16; }
.status-COMPLETED { color: #52c41a; }
.status-EVALUATED { color: #52c41a; }
.status-CANCELLED { color: #999; }
.status-COMPLAINED { color: #ff4d4f; }

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.label { color: #909399; width: 160rpx; }

.value { flex: 1; text-align: right; word-break: break-all; }

.price { color: #ff4d4f; font-weight: 600; }

.actions { display: flex; flex-direction: column; gap: 20rpx; margin-top: 8rpx; }

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

.dialog {
  width: 620rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-sizing: border-box;
}

.dialog-title { font-size: 32rpx; font-weight: 600; margin-bottom: 28rpx; }

.rate-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.rate-row slider { flex: 1; }

.dialog-textarea {
  width: 100%;
  height: 160rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  margin-bottom: 32rpx;
}

.dialog-btns {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
}
